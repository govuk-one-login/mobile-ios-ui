{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "iOS Common",
      "component": "mobile-ios-ui",
      "promotionType": "library",
      "checks": [
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "code quality",
            "secret scanning",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "path": "$.jobs.build"
          }
        },
        {
          "checkTypes": [
            "unit test coverage",
            "code quality",
            "secret scanning"
          ],
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/quality-report.yml",
            "path": "$.jobs.build"
          }
        }
      ]
    }
  ]
}
