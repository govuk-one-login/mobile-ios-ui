{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "mobile-ios-ui",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "code quality",
            "secret scanning",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "path": "$.jobs.build"
          }
        },
        {
          "checkTypes": [
            "unit test coverage",
            "code quality",
            "secret scanning"
          ],
          "phase": "pre-upload",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/quality-report.yml",
            "path": "$.jobs.build"
          }
        }
      ]
    }
  ]
}
