{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "iOS Common",
      "component": "mobile-ios-ui",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pull-request.yml",
            "path": "$.jobs.build"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-release",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/quality-report.yml",
            "path": "$.jobs.build"
          },
          "checks": [
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            },
            {
              "name": "secret scanning"
            }
          ]
        }
      ]
    }
  ]
}
